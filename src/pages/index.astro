---
import Dashboard from '../components/Dashboard.jsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel Ejecutivo | Análisis ABC-XYZ</title>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <main class="min-h-screen p-4 md:p-8">
      <header class="max-w-7xl mx-auto mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Análisis de Portafolio e Inventario</h1>
        <p class="text-slate-500 mt-1">Clasificación ABC (Facturación) y XYZ (Volatilidad de Demanda)</p>
      </header>
      
      <!-- Arquitectura de Islas: El dashboard carga React solo donde se necesita -->
      <Dashboard client:load />
    </main>
  </body>
</html>